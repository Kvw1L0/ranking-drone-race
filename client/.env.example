# ========================================================
# CREDENCIALES DE GOOGLE FIREBASE PARA DESPLIEGUE EN LA NUBE (VERCEL)
# ========================================================
# Pega aquí los valores de tu proyecto de Firebase Console (Proyecto Web)
#
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ========================================================
# BACKEND LOCAL / SOCKET.IO (OPCIONAL SI USAS FIREBASE)
# ========================================================
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
